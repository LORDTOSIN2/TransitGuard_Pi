# Copy this file to .env (or /etc/transitguard.env for systemd deployment)
# and fill in your real values. Never commit the real .env to Git.

# Supabase ingest-telemetry Edge Function URL
SUPABASE_INGEST_URL=https://your-project-ref.supabase.co/functions/v1/ingest-telemetry

# Unique identifier for this vehicle/OBU
TRANSITGUARD_DEVICE_ID=BUS-101

# Your real device auth token — rotate immediately if this value is ever
# exposed in a document, chat, or public repo
TRANSITGUARD_DEVICE_TOKEN=replace_with_your_real_device_token

# How often to send telemetry when driverState is NORMAL (seconds)
PUBLISH_INTERVAL_SEC=10.0

# Minimum gap between telemetry sends while a driver alert is active (or a
# state transition just occurred). Without this the ~20 FPS loop enqueued a
# message per iteration and a sustained alarm overflowed the queue, discarding
# ~49% of alert messages. Entering an alert is still reported promptly.
ALERT_PUBLISH_MIN_INTERVAL_SEC=5.0

# Safety margin for the telemetry queue (the rate limit above is the primary
# control). Messages beyond this depth are dropped oldest-first.
TELEMETRY_QUEUE_MAXSIZE=50

# --- GPS ---
# Ask the module for GGA/GSA/GSV/RMC/VTG output at startup. Some boards ship
# with only RMC enabled, which hides the satellite count (GGA) and
# satellites-in-view/SNR (GSV) used by the dashboard and telemetry.
GPS_ENABLE_SENTENCES=true

# Where to store the offline store-and-forward SQLite buffer
BUFFER_DB_PATH=/home/pi/.transitguard_buffer.db

# Max packets to keep queued offline before the oldest get pruned
MAX_BUFFERED_PACKETS=5000

# Set to false for headless/systemd auto-run (no display available)
ENABLE_PREVIEW=true

# Live browser dashboard (video feed + metrics), served at :DASHBOARD_PORT
ENABLE_DASHBOARD=true
DASHBOARD_PORT=8080

# --- Optional manual Wi-Fi switch (dashboard button) ---
# Adds a button to the live dashboard that manually moves the Pi between its
# normal network and a second saved network. The second profile is created
# with autoconnect disabled, so a power cycle always returns the Pi to its
# normal network — switching is session-only by design.
# Leave WIFI_SWITCH_TARGET_SSID blank to hide the button entirely.
WIFI_SWITCH_ENABLED=true
WIFI_SWITCH_TARGET_SSID=
WIFI_SWITCH_TARGET_PASSWORD=
# SSID of the normal network, so the button can switch back to it.
WIFI_SWITCH_HOME_SSID=

# --- Optional telemetry tracing (connection-stability evaluation) ---
# When set, appends one JSON line per scheduled/attempted/dropped telemetry
# event (monotonic RTT, HTTP status, server Date) to this file. Leave empty
# (default) to disable. Used for delivery-ratio / latency measurement runs.
TELEMETRY_TRACE_PATH=

# --- Optional camera-metrics log (availability evaluation) ---
# When set, appends one JSON line per second with face-present status,
# EAR/MAR/PERCLOS, head pose, classifier output and frame rate. Metrics only:
# no frames or video are written. Leave empty (default) to disable.
CAMERA_METRICS_LOG_PATH=
